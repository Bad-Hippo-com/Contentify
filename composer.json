{
    "name": "contentify/contentify",
    "description": "Contentify is an esports CMS based on the Laravel 5 framework.",
    "keywords": ["cms", "contentify", "gaming", "esports", "website"],
    "homepage": "http://www.contentify.org",
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "packages/caffeinated-modules",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "packages/laravel-steam-auth",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "packages/laravelcollective-html",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": "~8.5.0",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "caffeinated/modules": "^6.3.5",
        "cartalyst/sentinel": "^9.0",
        "chriskonnertz/bbcode": "1.*",
        "chriskonnertz/jobs": "3.*",
        "chriskonnertz/open-graph": "1.*",
        "intervention/image": "2.*",
        "invisnik/laravel-steam-auth": "^4.4.3",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.5",
        "laravelcollective/html": "^6.4.3",
        "oyejorge/less.php": "1.*",
        "watson/validating": "3.*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0",
        "squizlabs/php_codesniffer": "*"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/",
            "Contentify\\": "contentify"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
